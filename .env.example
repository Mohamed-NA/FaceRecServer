# Docker image names used by infra/docker/compose.yaml
APP_IMAGE=facerecserver-app:local
MODELS_IMAGE=facerecserver-models:local

# Container defaults. Keep TLS off when running behind a reverse proxy or on localhost.
FACEREC_ENABLE_TLS=0
FACEREC_REQUIRE_TLS=0
FACEREC_CERTIFICATES_DIR=./certificates

# Set these in GitHub repository secrets for Docker Hub publishing:
# DOCKERHUB_USERNAME
# DOCKERHUB_TOKEN
